<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShoeStoreApplication">

        <!-- Thiết lập LoginActivity là màn hình khởi chạy đầu tiên -->
        <activity
            android:name="com.example.shoestoreapplication.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Khai báo RegisterActivity -->
        <activity
            android:name="com.example.shoestoreapplication.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- MainActivity-->
        <activity
            android:name="com.example.shoestoreapplication.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Khai báo đầy đủ tên package cho ProfileActivity -->
        <activity
            android:name="com.example.shoestoreapplication.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>