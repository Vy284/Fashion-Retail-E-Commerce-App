<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#EFEFEF"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Khung chứa ảnh sản phẩm và nút trái tim yêu thích ở góc trên -->
        FrameLayout cho phép đặt ảnh ở dưới và icon trái tim nổi lên trên góc phải ảnh -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#F5F5F5">

            <!-- Ảnh sản phẩm -->
            <ImageView
                android:id="@+id/img_product"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@android:drawable/ic_menu_gallery" />

            <!-- Nút biểu tượng trái tim (Yêu thích) nằm đè góc phải -->
            <ImageButton
                android:id="@+id/btn_favorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_search_box"
                android:backgroundTint="#FFFFFF"
                android:contentDescription="Thêm vào yêu thích"
                android:padding="8dp"
                android:src="@android:drawable/ic_menu_today"
                app:tint="#111111" />
        </FrameLayout>

        <!-- Phần thông tin chi tiết sản phẩm bên dưới -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Tên thương hiệu (Ví dụ: Adidas, Nike, New Balance...) -->
            <TextView
                android:id="@+id/tv_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Adidas"
                android:textColor="#888888"
                android:textSize="11sp" />

            <!-- Tên sản phẩm -->
            <TextView
                android:id="@+id/tv_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Yeezy Boost 350 V2"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Giá tiền (Màu cam chủ đạo #FF5722) -->
            <TextView
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="6.890.000đ"
                android:textColor="#FF5722"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>