<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical">

    <!-- ================= 1. TOOLBAR / HEADER ================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Nút Quay Lại đã đồng bộ chuẩn icon ic_back -->
        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:padding="12dp"
            android:src="@drawable/ic_back"
            app:tint="#000000" />

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Danh mục sản phẩm"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Đường gạch ngang phân cách nhẹ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EFEFEF" />

    <!-- ================= 2. THANH TÌM KIẾM & BỘ LỌC ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:gravity="center_vertical">

        <!-- Ô Tìm Kiếm -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_box"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <!-- Gọi icon search nội bộ của dự án -->
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="#757575" />

            <EditText
                android:id="@+id/edt_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="Tìm kiếm giày, thương hiệu..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="8dp"
                android:singleLine="true"
                android:textColor="#000000"
                android:textColorHint="#9E9E9E"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Nút Bộ Lọc (Gọi icon filter nội bộ của dự án) -->
        <ImageButton
            android:id="@+id/btn_filter"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_search_box"
            android:contentDescription="Bộ lọc"
            android:padding="12dp"
            android:src="@drawable/ic_filter"
            app:tint="#111111" />
    </LinearLayout>

    <!-- ================= 3. THANH CHỌN DANH MỤC (CHIPS NGANG) ================= -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_nam"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Nam"
                android:textColor="@color/chip_text_color_selector"
                app:chipBackgroundColor="@color/chip_bg_color_selector"
                app:chipStrokeColor="#E0E0E0"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_nu"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nữ"
                android:textColor="@color/chip_text_color_selector"
                app:chipBackgroundColor="@color/chip_bg_color_selector"
                app:chipStrokeColor="#E0E0E0"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_unisex"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unisex"
                android:textColor="@color/chip_text_color_selector"
                app:chipBackgroundColor="@color/chip_bg_color_selector"
                app:chipStrokeColor="#E0E0E0"
                app:chipStrokeWidth="1dp" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_tre_em"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Trẻ Em"
                android:textColor="@color/chip_text_color_selector"
                app:chipBackgroundColor="@color/chip_bg_color_selector"
                app:chipStrokeColor="#E0E0E0"
                app:chipStrokeWidth="1dp" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Đường gạch ngang phân cách khối header -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EFEFEF" />

    <!-- ================= 4. NỘI DUNG CHÍNH (SỐ LƯỢNG & LƯỚI SẢN PHẨM) ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <!-- Số lượng sản phẩm tìm thấy -->
        <TextView
            android:id="@+id/tv_result_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="148 sản phẩm tìm thấy"
            android:textColor="#757575"
            android:textSize="13sp" />

        <!-- RecyclerView hiển thị dạng Lưới (Grid 2 cột) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_category_products"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:itemCount="4"
            tools:listitem="@layout/item_product_grid" />

    </LinearLayout>

</LinearLayout>