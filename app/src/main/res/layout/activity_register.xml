<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo & Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="KICKS."
            android:textColor="#FF5722"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tạo tài khoản mới"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Họ và Tên -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Họ và Tên"
            android:textColor="#424242"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_reg_fullname"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="Nhập họ và tên đầy đủ"
            android:textColorHint="#888888"
            android:imeOptions="actionNext"
            android:inputType="textPersonName"
            android:paddingHorizontal="18dp"
            android:textColor="#000000"
            android:textSize="15sp" />

        <!-- Số điện thoại -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Số điện thoại"
            android:textColor="#424242"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_reg_phone"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="Vui lòng nhập số điện thoại"
            android:textColorHint="#888888"
            android:imeOptions="actionNext"
            android:inputType="phone"
            android:paddingHorizontal="18dp"
            android:textColor="#000000"
            android:textSize="15sp" />

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Email"
            android:textColor="#424242"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_reg_email"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="Nhập email"
            android:textColorHint="#888888"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="18dp"
            android:textColor="#000000"
            android:textSize="15sp" />

        <!-- Mật khẩu -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mật khẩu"
            android:textColor="#424242"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field">

            <EditText
                android:id="@+id/edt_reg_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/btn_toggle_reg_password"
                android:background="@null"
                android:hint="Nhập mật khẩu"
                android:textColorHint="#888888"
                android:imeOptions="actionNext"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="8dp"
                android:textColor="#000000"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_toggle_reg_password"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ẩn hiện mật khẩu"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye_closed"
                app:tint="#757575" />
        </RelativeLayout>

        <!-- Xác nhận mật khẩu -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Xác nhận mật khẩu"
            android:textColor="#424242"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field">

            <EditText
                android:id="@+id/edt_reg_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/btn_toggle_reg_confirm_password"
                android:background="@null"
                android:hint="Nhập lại mật khẩu"
                android:textColorHint="#888888"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="8dp"
                android:textColor="#000000"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_toggle_reg_confirm_password"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ẩn hiện mật khẩu xác nhận"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye_closed"
                app:tint="#757575" />
        </RelativeLayout>

        <!-- Khoảng không linh hoạt -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <!-- Nút Đăng Ký Tài Khoản -->
        <Button
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#111111"
            android:text="Đăng Ký Tài Khoản"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Chuyển Đăng Nhập -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn đã có tài khoản?"
                android:textColor="#757575"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_go_to_login"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng nhập"
                android:textAllCaps="false"
                android:textColor="#FF5722"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>