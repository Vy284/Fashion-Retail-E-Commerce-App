<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical">

    <!-- ================= 1. HEADER ================= -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="20dp"
        app:elevation="6dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Quay lại"
            android:src="@drawable/ic_back"
            app:tint="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Chi Tiết Sản Phẩm"
            android:textColor="#000000"
            android:textSize="26sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btn_favorite"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_favorite_button"
            android:contentDescription="Yêu thích"
            android:padding="14dp"
            android:src="@drawable/ic_favorite_border"
            app:tint="#FF5722" />
    </RelativeLayout>

    <!-- ================= 2. PHẦN NỘI DUNG CUỘN ================= -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Ảnh chính sản phẩm (Siêu to khổng lồ: 400dp) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="#DDDDDD"
                app:strokeWidth="1.5dp">

                <ImageView
                    android:id="@+id/img_product_main"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Ảnh sản phẩm chính"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/img_welcome_shoe" />
            </androidx.cardview.widget.CardView>

            <!-- Ảnh thu nhỏ (Thumbnails cực lớn: 100dp) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/bg_thumbnail_selected"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/img_welcome_shoe" />
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="16dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/img_welcome_shoe" />
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="16dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/img_welcome_shoe" />
                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:scaleType="centerCrop"
                    tools:src="@drawable/img_welcome_shoe" />
            </LinearLayout>

            <!-- Thương hiệu, Tên, Giá (Cỡ chữ cực đại) -->
            <TextView
                android:id="@+id/tv_product_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:textColor="#FF5722"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="JORDAN SNEAKER" />

            <TextView
                android:id="@+id/tv_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:textColor="#111111"
                android:textSize="36sp"
                android:textStyle="bold"
                tools:text="Air Jordan 1 'Chicago'" />

            <TextView
                android:id="@+id/tv_product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:textColor="#111111"
                android:textSize="34sp"
                android:textStyle="bold"
                tools:text="5.490.000đ" />

            <!-- Chọn màu sắc (Vòng tròn màu 70dp) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Chọn Màu Sắc"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:orientation="horizontal">
                <View android:layout_width="70dp" android:layout_height="70dp" android:layout_marginEnd="20dp" android:background="@drawable/bg_color_red"/>
                <View android:layout_width="70dp" android:layout_height="70dp" android:layout_marginEnd="20dp" android:background="@drawable/bg_color_black"/>
                <View android:layout_width="70dp" android:layout_height="70dp" android:layout_marginEnd="20dp" android:background="@drawable/bg_color_blue"/>
                <View android:layout_width="70dp" android:layout_height="70dp" android:background="@drawable/bg_color_grey"/>
            </LinearLayout>

            <!-- Chọn kích cỡ (Ô size siêu khổng lồ: 72dp x 64dp, chữ 24sp) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Chọn Kích Cỡ (US)"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="69dp"
                android:layout_marginBottom="32dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_size_unselected"
                    android:gravity="center"
                    android:text="38"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_size_unselected"
                    android:gravity="center"
                    android:text="39"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_size_unselected"
                    android:gravity="center"
                    android:text="40"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_size_selected"
                    android:gravity="center"
                    android:text="41"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="64dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_size_unselected"
                    android:gravity="center"
                    android:text="42"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="72dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_size_unselected"
                    android:gravity="center"
                    android:text="43"
                    android:textColor="#000000"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Mô tả sản phẩm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Mô Tả Sản Phẩm"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_product_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#333333"
                android:textSize="20sp"
                android:lineSpacingExtra="12dp"
                tools:text="Giày thể thao cao cấp chính hãng thiết kế trẻ trung, ôm chân, đế cao su chống trượt bền bỉ phù hợp cho mọi hoạt động dạo phố và thể thao." />

        </LinearLayout>
    </ScrollView>

    <!-- ================= 3. THANH HÀNH ĐỘNG DƯỚI ĐÁY (CART BUTTON & QUANTITY) ================= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="24dp"
        app:elevation="20dp">

        <!-- Bộ tăng giảm số lượng khổng lồ -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_quantity_box"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageButton
                android:id="@+id/btn_decrease"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Giảm"
                android:src="@drawable/ic_minus"
                app:tint="#111111" />

            <TextView
                android:id="@+id/tv_quantity"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="#000000"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_increase"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tăng"
                android:src="@drawable/ic_plus"
                app:tint="#111111" />
        </LinearLayout>

        <!-- Nút Thêm vào giỏ hàng (Cart Button) Siêu To Khổng Lồ -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_to_cart"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:backgroundTint="#FF5722"
            android:text="Thêm Vào Giỏ Hàng"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_cart"
            app:iconGravity="text_start"
            app:iconSize="32dp"
            app:iconPadding="12dp"
            app:iconTint="#FFFFFF" />
    </LinearLayout>

</LinearLayout>