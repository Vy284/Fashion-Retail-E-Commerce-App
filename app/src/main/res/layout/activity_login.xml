<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Logo & Tiêu đề -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="KICKS."
            android:textColor="#FF5722"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Chào mừng trở lại!"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Đăng nhập để cập nhật những phát hành sneaker hot nhất."
            android:textColor="#757575"
            android:textSize="14sp" />

        <!-- Input Email / SĐT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Email hoặc Số điện thoại"
            android:textColor="#424242"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edt_login_email"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="Hãy nhập email hoặc số điện thoại"
            android:textColorHint="#888888"
            android:imeOptions="actionNext"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="18dp"
            android:textColor="#000000"
            android:textSize="15sp" />

        <!-- Input Mật khẩu -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mật khẩu"
            android:textColor="#424242"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_field">

            <EditText
                android:id="@+id/edt_login_password"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toStartOf="@id/btn_toggle_password"
                android:background="@null"
                android:hint="Hãy nhập mật khẩu"
                android:textColorHint="#888888"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="8dp"
                android:textColor="#000000"
                android:textSize="15sp" />

            <!-- Nút ImageButton con mắt dạng Vector XML -->
            <ImageButton
                android:id="@+id/btn_toggle_password"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Ẩn hiện mật khẩu"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_eye_closed"
                app:tint="#757575" />
        </RelativeLayout>

        <!--        &lt;!&ndash; Quên mật khẩu? &ndash;&gt;-->
        <!--        <TextView-->
        <!--            android:id="@+id/tv_forgot_password"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:layout_gravity="end"-->
        <!--            android:layout_marginTop="12dp"-->
        <!--            android:padding="4dp"-->
        <!--            android:text="Quên mật khẩu?"-->
        <!--            android:textColor="#FF5722"-->
        <!--            android:textSize="13sp"-->
        <!--            android:textStyle="bold" />-->

        <!-- Khoảng không linh hoạt đẩy nút xuống đáy màn hình -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <!-- Nút Đăng Nhập -->
        <Button
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#111111"
            android:text="Đăng Nhập"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="12dp" />

        <!-- Nút Đăng Ký (Sử dụng Button TextButton) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bạn chưa có tài khoản?"
                android:textColor="#757575"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btn_go_to_register"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đăng ký ngay"
                android:textAllCaps="false"
                android:textColor="#FF5722"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>