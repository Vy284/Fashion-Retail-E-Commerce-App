<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none"
    tools:ignore="HardcodedText,SpellCheckingInspection,ButtonStyle,ContentDescription">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Quay lại"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Thanh toán"
                android:textColor="#263238"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="10dp"
                android:src="@drawable/ic_security_check"
                android:contentDescription="Bảo mật" />

        </LinearLayout>


        <!-- ================= TITLE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Chọn thẻ thanh toán"
            android:textColor="#263238"
            android:textSize="27sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Chọn một thẻ đã lưu để tiếp tục."
            android:textColor="#78909C"
            android:textSize="13sp" />


        <!-- ================= SAVED CARD TITLE ================= -->

        <TextView
            android:id="@+id/txtSavedCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Thẻ đã lưu (0)"
            android:textColor="#607D8B"
            android:textSize="13sp"
            android:textStyle="bold" />


        <!-- ================= EMPTY CARD ================= -->

        <!--
            KHÔNG dùng Space.
            CardView này tự giãn để lấp phần còn lại.
        -->

        <androidx.cardview.widget.CardView
            android:id="@+id/layoutEmptyCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:minHeight="205dp"
            app:cardBackgroundColor="#FAFCFD"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#D8E2E8"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- ICON THẺ -->

                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp">

                    <ImageView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_gravity="center"
                        android:alpha="0.65"
                        android:src="@drawable/ic_card"
                        android:contentDescription="Thẻ" />

                    <TextView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom|end"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="#607D8B"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </FrameLayout>


                <!-- TITLE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Chưa có thẻ nào"
                    android:textColor="#263238"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- DESCRIPTION -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center"
                    android:text="Thêm thẻ để thanh toán nhanh chóng&#10;và an toàn hơn."
                    android:textColor="#78909C"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= ADD CARD BUTTON ================= -->

        <Button
            android:id="@+id/btnAddCard"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#FF3D00"
            android:gravity="center"
            android:text="+   Thêm thẻ mới"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />


        <!-- ================= TOTAL PAYMENT ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tổng thanh toán"
                android:textColor="#78909C"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtTotalPayment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0đ"
                android:textColor="#263238"
                android:textSize="19sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================= SECURITY ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:padding="3dp"
                android:src="@drawable/ic_lock"
                android:contentDescription="Bảo mật" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="Vua lòng thêm thẻ để thanh toán"
                android:textColor="#78909C"
                android:textSize="11sp" />

        </LinearLayout>


        <!-- ================= PAYMENT BUTTON ================= -->

        <Button
            android:id="@+id/btnPayment"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:backgroundTint="#7E8794"
            android:enabled="false"
            android:gravity="center"
            android:text="Thanh toán"
            android:textAllCaps="false"
            android:textColor="#D9DDE2"
            android:textSize="15sp"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

    </LinearLayout>

</ScrollView>